# Claude API key. Optional: without it the app falls back to simple non-AI parsing and answers.
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-haiku-5-5
# PayPal JS SDK client ID. "sb" is PayPal's public sandbox ID and needs no account.
PAYPAL_CLIENT_ID=sb
# Public base URL used in checkout links. Defaults to the request's own host.
PUBLIC_URL=
PORT=3000

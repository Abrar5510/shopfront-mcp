# Gemini API key (free tier works: https://aistudio.google.com/apikey). Optional: without it the app falls back to simple non-AI parsing and answers.
GEMINI_API_KEY=
# Optional overrides. Any Gemini text model name; the default alias tracks Google's latest Flash-Lite model (fast, free tier).
GEMINI_MODEL=gemini-flash-lite-latest
# PayPal JS SDK client ID. "sb" is PayPal's public sandbox ID and needs no account.
PAYPAL_CLIENT_ID=sb
# Public base URL used in checkout links. Defaults to the request's own host.
PUBLIC_URL=
PORT=3000
